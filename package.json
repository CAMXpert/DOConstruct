{
  "name": "doconstruct",
  "productName": "DOConstruct",
  "version": "0.2.5",
  "description": "Document construction, editing and incremental typesetting desktop workbench.",
  "main": "src/main.cjs",
  "license": "MIT",
  "scripts": {
    "build:ui": "esbuild src/renderer/main.js --bundle --outfile=static/app.js --format=iife --target=chrome120",
